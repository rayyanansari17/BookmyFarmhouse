# Copy to deploy/oracle/.env and fill in. NEVER commit the real .env.
# Public IP of your Oracle VM with dots replaced by dashes, e.g. 129.146.10.5 -> 129-146-10-5
SCRAPER_HOST=scraper.129-146-10-5.sslip.io

# Generate each with: openssl rand -hex 24
REDIS_PASSWORD=
SCRAPER_SECRET=      # must equal SCRAPER_SECRET on Vercel
