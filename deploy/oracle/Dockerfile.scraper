# Playwright scraper — Chromium + OS deps are installed by the package's own
# postinstall (`playwright install chromium --with-deps`), which works because
# Docker builds run as root. Works on both amd64 and Oracle's arm64 VMs.
FROM node:20-bookworm-slim
WORKDIR /app

COPY scraper/package*.json ./
RUN npm install

COPY scraper/tsconfig.json ./
COPY scraper/src ./src
# Compile ahead of time: ts-node at runtime can run out of memory on small hosts
RUN npx tsc

ENV NODE_ENV=production
EXPOSE 3001
CMD ["node", "dist/index.js"]
